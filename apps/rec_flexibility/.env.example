# Upstream source schemas
CELINE_SILVER_SCHEMA=ds_dev_silver
CELINE_GOLD_SCHEMA=ds_dev_gold

# The fleet is the REC registry's membership (rec_registry's rec_device_membership):
# no device list is configured here.

# Test-phase auto-commit (set to "true" to enable synthetic commitments; each one
# belongs to its device's own community)
# AUTO_COMMIT_ENABLED=false

# Fair gamification overrides (spec 2026-10-07 §4.7). CSV text, header optional, one
# device per line: device_id,pv_class_override,category_override,quarantine_from,quarantine_reason,battery_declared
# Written to dbt/seeds/rec_device_overrides.csv at flow start; header-only when unset.
# REC_FAIR_OVERRIDES_CSV=
